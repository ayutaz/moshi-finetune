{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format-python.sh\"",
            "timeout": 60,
            "statusMessage": "Formatting Python"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pytest-before-commit.sh\"",
            "if": "Bash(git commit *)",
            "timeout": 180,
            "statusMessage": "Running the experiment data gates"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/warn-running-gpu.sh\"",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
